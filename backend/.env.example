# development 또는 production
APP_ENV=development

# 운영에서는 관리형 PostgreSQL 접속 URL을 사용합니다.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DB_NAME

# 개발 예시: http://localhost:5173,http://127.0.0.1:5173
# 운영 예시: https://frontend.example.com
# APP_ENV=production 에서는 https 운영 도메인만 허용됩니다.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Linux 운영 환경 예시. 실제 설치된 한글 폰트 경로로 바꿉니다.
PDF_FONT_PATH=/usr/share/fonts/truetype/noto/NotoSansKR-Regular.ttf
PDF_FONT_BOLD_PATH=/usr/share/fonts/truetype/noto/NotoSansKR-Bold.ttf
